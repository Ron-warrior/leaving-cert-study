---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NavDrawer from "../components/NavDrawer.astro";
import ProgressManager from "../components/ProgressManager.svelte";
import { withBase } from "../lib/paths";
---

<Base
  title="Progress · Leaving Cert Study"
  description="Export or restore the study progress saved in this browser."
>
  <main id="main" class="wrap search-page progress-page">
    <div class="subject-bar">
      <NavDrawer />
      <span class="subject-bar-name">Progress</span>
      <a class="web-back" href={withBase("/")}>← All subjects</a>
      <a class="icon-btn" href={withBase("search/")} aria-label="Search notes and questions"><Icon name="search" /></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode"><Icon name="sun" /><Icon name="moon" /></button>
    </div>

    <header class="search-head">
      <p class="eyebrow">Your data</p>
      <h1>Keep your progress portable.</h1>
      <p>
        Everything is local to this browser. Download a JSON copy to move it, or restore a
        previous copy. Nothing is sent to a server.
      </p>
    </header>

    <ProgressManager client:load />
  </main>
</Base>
